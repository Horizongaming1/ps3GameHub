APP_NAME=ps3cache-api
APP_ENV=production
PS3CACHE_IMAGE=ps3cache-api:0.1.0

API_HOST=0.0.0.0
API_PORT=8080
API_PUBLIC_PORT=8087

DATABASE_URL=sqlite:////data/ps3cache.db

# Host path on OMV/NAS where your game ISOs are stored.
LIBRARY_HOST_PATH=/srv/dev-disk-by-uuid-REPLACE/ps3library
LIBRARY_ROOT=/library

LOG_LEVEL=INFO
LOG_DIR=/logs
LOG_FILE_NAME=app.log

SCAN_ON_STARTUP=true
SCAN_RECURSIVE=true

WORKER_POLL_INTERVAL_SEC=2
WORKER_COPY_CHUNK_SIZE=1048576
WORKER_MAX_RETRIES=1

FTP_TIMEOUT_SEC=20
WEBMAN_TIMEOUT_SEC=4

TZ=Europe/Berlin
